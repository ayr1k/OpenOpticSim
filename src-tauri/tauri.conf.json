{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOpticSim",
  "version": "1.3.0",
  "identifier": "org.openopticsim.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenOpticSim · 光学工作室",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../docs/catalog/CC0-1.0.txt": "glass-catalog-CC0-1.0.txt",
      "../examples/400mm-repaired.oos.json": "examples/400mm-repaired.oos.json",
      "../examples/400mm-workflow-0.8.oos.json": "examples/400mm-workflow-0.8.oos.json",
      "../examples/400mm-coverage-0.9.oos.json": "examples/400mm-coverage-0.9.oos.json",
      "../examples/35mm-coverage.oos.json": "examples/35mm-coverage.oos.json",
      "../docs/manual/": "manual/",
      "../docs/OOS-1.0-使用手册.html": "OOS-1.0-使用手册.html",
      "../docs/OOS-1.0-使用手册.md": "OOS-1.0-使用手册.md",
      "../src/assets/fonts/OFL.txt": "fonts/OFL.txt",
      "../src/assets/fonts/source.json": "fonts/source.json",
      "../examples/24-70mm-zoom.oos.json": "examples/24-70mm-zoom.oos.json",
      "../docs/OOS-1.1-使用手册.md": "OOS-1.1-使用手册.md",
      "../docs/OOS-1.1-使用手册.html": "OOS-1.1-使用手册.html",
      "../docs/OOS-1.2-使用手册.md": "OOS-1.2-使用手册.md",
      "../docs/OOS-1.2-使用手册.html": "OOS-1.2-使用手册.html",
      "../docs/OOS-1.3-使用手册.md": "OOS-1.3-使用手册.md",
      "../docs/OOS-1.3-使用手册.html": "OOS-1.3-使用手册.html",
      "../examples/tessar-50mm-1.3.oos.json": "examples/tessar-50mm-1.3.oos.json",
      "../examples/planar-50mm-1.3.oos.json": "examples/planar-50mm-1.3.oos.json",
      "../examples/double_gauss-50mm-1.3.oos.json": "examples/double_gauss-50mm-1.3.oos.json",
      "../examples/sonnar-50mm-1.3.oos.json": "examples/sonnar-50mm-1.3.oos.json"
    },
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
